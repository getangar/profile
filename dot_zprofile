# ~/.zprofile — eseguito una volta per ogni login shell.
# Obiettivo: costruire l'ambiente senza lanciare processi bash.

# Guardia contro il doppio sourcing.
[[ -n ${__ZPROFILE_LOADED-} ]] && return
typeset -g __ZPROFILE_LOADED=1

# Rimuove automaticamente i duplicati da PATH/FPATH/MANPATH.
typeset -U path fpath manpath


# --- Homebrew ---------------------------------------------------------------
# Equivalente statico di `brew shellenv`. Per rigenerarlo:
#     /opt/homebrew/bin/brew shellenv
export HOMEBREW_PREFIX="/opt/homebrew"
export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
export HOMEBREW_REPOSITORY="/opt/homebrew"
export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"

path=(/opt/homebrew/bin /opt/homebrew/sbin $path)
fpath=(/opt/homebrew/share/zsh/site-functions $fpath)


# --- pyenv (solo shim) ------------------------------------------------------
export PYENV_ROOT="$HOME/.pyenv"
path=($PYENV_ROOT/shims $path)


# --- rbenv (solo shim) ------------------------------------------------------
# Davanti a /opt/homebrew/bin, così vince sul Ruby di Homebrew.
path=($HOME/.rbenv/shims $path)


# --- Percorsi personali -----------------------------------------------------
path=($HOME/.local/bin $path)        # pipx e binari locali
path=($path $HOME/.lmstudio/bin)     # LM Studio CLI

export PATH
