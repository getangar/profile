# ~/.zshrc — solo shell interattive.
# Regola: mai `$(brew ...)`, e pyenv/rbenv inizializzati una sola volta
# da cache, perché sono script bash.

# --- Prompt (oh-my-posh) ----------------------------------------------------
if [[ $TERM_PROGRAM != "Apple_Terminal" ]]; then
  eval "$(oh-my-posh init zsh --config $HOMEBREW_PREFIX/opt/oh-my-posh/themes/atomicBit.omp.json)"
fi


# --- Alias ------------------------------------------------------------------
alias ls='lsd'
alias l='ls -l'
alias ll='ls -al'
alias k='kubectl'
alias vi='nvim'
alias cat='bat'
alias nano='/opt/homebrew/bin/nano'
alias hh='hstr'
alias fe="fzf --preview 'bat --style=numbers --color=always {} | head -500'"
alias fev='fzf --preview "bat --style=numbers --color=always {} | head -500" | xargs -o nvim'
alias fen='fzf --preview "bat --style=numbers --color=always {} | head -500" | xargs -o nano'

export EDITOR="nvim"


# --- hstr -------------------------------------------------------------------
export HSTR_CONFIG=hicolor
export HSTR_TIOCSTI=y
setopt histignorespace          # comandi con spazio iniziale fuori dalla history


# --- Completamento ----------------------------------------------------------
fpath=($HOME/.docker/completions $fpath)

autoload -Uz compinit
_zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION"
mkdir -p ${_zcompdump:h}
compinit -d $_zcompdump
unset _zcompdump


# --- pyenv ------------------------------------------------------------------
# Init in cache; gli shim li mette .zprofile. Per rigenerare:
#     rm ~/.cache/zsh/pyenv-init.zsh
_pyenv_init="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/pyenv-init.zsh"
if [[ ! -s $_pyenv_init || ${commands[pyenv]} -nt $_pyenv_init ]]; then
  mkdir -p ${_pyenv_init:h}
  {
    pyenv init - --no-push-path zsh
    pyenv virtualenv-init - zsh
  } > $_pyenv_init
fi
source $_pyenv_init
unset _pyenv_init


# --- rbenv ------------------------------------------------------------------
# Init in cache; gli shim li mette .zprofile. Dopo aver installato una gem
# con eseguibili, se il comando non si trova: `rbenv rehash`. Per rigenerare:
#     rm ~/.cache/zsh/rbenv-init.zsh
_rbenv_init="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/rbenv-init.zsh"
if [[ ! -s $_rbenv_init || ${commands[rbenv]} -nt $_rbenv_init ]]; then
  mkdir -p ${_rbenv_init:h}
  rbenv init - --no-rehash zsh > $_rbenv_init
fi
source $_rbenv_init
unset _rbenv_init
# rbenv init ri-antepone gli shim già messi da .zprofile: tiene solo
# la prima occorrenza di ogni voce del PATH.
path=(${(u)path})


# --- fzf --------------------------------------------------------------------
if (( $+commands[fzf] )); then
  source <(fzf --zsh)
fi


# --- zsh-autosuggestions ----------------------------------------------------
source $HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh


# --- Keybinding -------------------------------------------------------------
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey "^[[A" up-line-or-beginning-search
bindkey "^[[B" down-line-or-beginning-search

# hstr su Ctrl-R: deve stare dopo fzf.
bindkey -s "\C-r" "\C-a hstr -- \C-j"

compdef sshrc=ssh
