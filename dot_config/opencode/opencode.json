{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-coder-xcode",
  "small_model": "ollama/qwen3-coder-xcode",
  "enabled_providers": ["ollama"],
  "autoupdate": false,
  "share": "disabled",
  "permission": {
	"edit": "ask",
	"bash": "ask"
  },
  "provider": {
	"ollama": {
	  "npm": "@ai-sdk/openai-compatible",
	  "name": "Ollama (local)",
	  "options": {
		"baseURL": "http://localhost:11434/v1"
	  },
	  "models": {
		"qwen3-coder-xcode": {
		  "name": "Qwen3 Coder 30B (Xcode)",
		  "limit": { "context": 32768, "output": 8192 }
		},
		"devstral:24b": {
		  "name": "Devstral 24B",
		  "limit": { "context": 32768, "output": 8192 }
		}
	  }
	}
  },
  "mcp": {
	"xcode": {
	  "type": "local",
	  "command": ["xcrun", "mcpbridge"],
	  "enabled": true
	}
  }
}