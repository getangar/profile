#!/bin/zsh
# Managed by chezmoi: runs on `chezmoi apply` whenever this script or the OpenCode template changes.
# opencode template hash: {{ include "dot_config/opencode/opencode.json.tmpl" | sha256sum }}
set -euo pipefail

MEM_GB=$(( $(sysctl -n hw.memsize) / 1073741824 ))

if (( MEM_GB >= 64 )); then
  CTX=65536
  KEEP=30m
  MODEL="qwen3.6:35b-a3b-coding-mxfp8"   # MLX 8-bit, ~38 GB
else
  CTX=32768
  KEEP=15m
  MODEL="qwen3.6:35b-mlx"                # MLX 4-bit, ~19 GB
fi

echo "[ollama-setup] RAM: ${MEM_GB} GB -> model ${MODEL}, context ${CTX}, keep-alive ${KEEP}"

# 1. Disable Ollama cloud features (local-only mode)
mkdir -p "$HOME/.ollama"
if [[ ! -f "$HOME/.ollama/server.json" ]]; then
  cat > "$HOME/.ollama/server.json" <<'EOF'
{
  "disable_ollama_cloud": true
}
EOF
fi

# 2. LaunchAgent: set Ollama env vars at every login, then restart the Ollama app
PLIST="$HOME/Library/LaunchAgents/local.ollama.env.plist"
mkdir -p "$HOME/Library/LaunchAgents"
cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.ollama.env</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>launchctl setenv OLLAMA_CONTEXT_LENGTH ${CTX}; launchctl setenv OLLAMA_KEEP_ALIVE ${KEEP}; launchctl setenv OLLAMA_NO_CLOUD 1; sleep 5; osascript -e 'quit app "Ollama"' || true; sleep 3; open -a Ollama</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
EOF

launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
launchctl bootstrap "gui/$(id -u)" "$PLIST"

# 3. Pull the model once the server is back up (fast if already present)
sleep 10
ollama pull "$MODEL"

echo "[ollama-setup] Done."
