#compdef tuist

__tuist_complete() {
    local -ar non_empty_completions=("${@:#(|:*)}")
    local -ar empty_completions=("${(M)@:#(|:*)}")
    _describe -V '' non_empty_completions -- empty_completions -P $'\'\''
}

__tuist_custom_complete() {
    local -a completions
    completions=("${(@f)"$("${command_name}" "${@}" "${command_line[@]}")"}")
    if [[ "${#completions[@]}" -gt 1 ]]; then
        __tuist_complete "${completions[@]:0:-1}"
    fi
}

__tuist_cursor_index_in_current_word() {
    if [[ -z "${QIPREFIX}${IPREFIX}${PREFIX}" ]]; then
        printf 0
    else
        printf %s "${#${(z)LBUFFER}[-1]}"
    fi
}

_tuist() {
    emulate -RL zsh -G
    setopt extendedglob nullglob numericglobsort
    unsetopt aliases banghist

    local -xr SAP_SHELL=zsh
    local -x SAP_SHELL_VERSION
    SAP_SHELL_VERSION="$(builtin emulate zsh -c 'printf %s "${ZSH_VERSION}"')"
    local -r SAP_SHELL_VERSION

    local context state state_descr line
    local -A opt_args

    local -r command_name="${words[1]}"
    local -ar command_line=("${words[@]}")
    local -ir current_word_index="$((CURRENT - 1))"

    local -i ret=1
    local -ar arg_specs=(
        '(-h --help)'{-h,--help}'[Show help information.]'
        '(-): :->command'
        '(-)*:: :->arg'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0
    case "${state}" in
    command)
        local -ar subcommands=(
            'init:Get started with Tuist in your project.'
            'hash:Utilities to debug the hashing logic used by features like binary caching or selective testing.'
            'cargo:Run Cargo with Tuist build and test insights.'
            'build:A set of commands to manage your project builds.'
            'cache:Cache-related commands.'
            'clean:Clean all the artifacts stored locally'
            'dump:Outputs the manifest as a JSON'
            'edit:Generates a temporary project to edit the project in the current directory'
            'generate:Generate a project or inspect generation runs.'
            'graph:Generates a graph from the workspace or project in the current directory'
            'install:Installs any remote content (e.g. dependencies) necessary to interact with the project.'
            'migration:A set of utilities to assist in the migration of Xcode projects to Tuist.'
            'plugin:A set of commands for plugin'\''s management.'
            'registry:A set of commands to interact with the Tuist Registry.'
            'run:Runs a preview or a scheme from a generated project.'
            'runner:Interact with Tuist runners.'
            'scaffold:Generates new project based on a template'
            'setup:Commands to set up and configure Tuist services'
            'teardown:Commands to tear down Tuist services previously set up with `tuist setup`'
            'test:Tests a project'
            'inspect:Inspect your project to identify issues such as implicit or redundant dependencies.'
            'coverage:Utilities for the code coverage gathered by test runs.'
            'xcodebuild:tuist xcodebuild extends the xcodebuild CLI with server capabilities such as insights and analytics.'
            'share:Generate a link to share your app or CLI.'
            'account:A set of commands to manage your Tuist account'
            'project:A set of commands to manage your Tuist projects.'
            'bundle:A set of commands to manage your project bundles.'
            'organization:A set of commands to manage your Tuist organizations.'
            'auth:Manage authentication'
            'version:Outputs the current version of tuist'
            'help:Show subcommand help information.'
        )
        _describe -V subcommand subcommands && ret=0
        ;;
    arg)
        case "${words[1]}" in
        init|hash|cargo|build|cache|clean|dump|edit|generate|graph|install|migration|plugin|registry|run|runner|scaffold|setup|teardown|test|inspect|coverage|xcodebuild|share|account|project|bundle|organization|auth|version|help)
            "_tuist_${words[1]}" && ret=0
            ;;
        esac
        ;;
    esac

    return "${ret}"
}

_tuist_init() {
    local -i ret=1
    local -ar arg_specs=(
        '(--path -p)'{--path,-p}'[The path to the directory from where to start. (env\: TUIST_INIT_PATH)]:path:_files -/'
        '(--build-system --workflow)'{--build-system,--workflow}'[The build system to integrate with, non-interactively. One of '\''xcode'\'' (integrate an existing Xcode project or workspace), '\''generated-xcode'\'' (create a Tuist-generated Xcode project), '\''gradle'\'' (integrate a Gradle project), or '\''bazel'\'' (integrate a Bazel workspace). When set, all remaining prompts are answered from the other flags. `--workflow` is accepted as an alias.]:build-system:'
        '--name[The project name. Also the server project handle. Defaults to the current directory name.]:name:'
        '--platform[The platform for a '\''generated-xcode'\'' project. One of '\''ios'\'', '\''macos'\'', '\''tvos'\'', '\''watchos'\''.]:platform:'
        '--server[Integrate with the Tuist server (create/select a project so features like caching and insights can flow). Defaults to true.]'
        '--no-server[Integrate with the Tuist server (create/select a project so features like caching and insights can flow). Defaults to true.]'
        '--account[The handle of the account that should own the project. Must be your handle or an organization you belong to.]:account:'
        '--create-organization[Create a new organization with this handle and use it as the project owner. Mutually exclusive with --account.]:create-organization:'
        '(-h --help)'{-h,--help}'[Show help information.]'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0

    return "${ret}"
}

